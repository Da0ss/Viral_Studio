NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy key, supported for existing projects only.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Keep disabled until staging Storage/concurrency acceptance is complete.
MEDIA_CLEANUP_ENABLED=false
# Separate cryptographically random 32-byte lowercase hex token; never NEXT_PUBLIC.
MEDIA_CLEANUP_SECRET=
# Separate worker credential for abandoned upload reconciliation.
MEDIA_UPLOAD_RECONCILE_ENABLED=false
MEDIA_UPLOAD_RECONCILE_SECRET=
# Shared scheduler bearer credential: separate random 32-byte lowercase hex.
CRON_SECRET=
WORKER_METRICS_ENABLED=false
# No paid provider calls until explicitly enabled and staging acceptance passes.
GENERATION_ENABLED=false
# Server-only Fal.ai API key used by the generation worker (not the enqueue route); never NEXT_PUBLIC.
FAL_KEY=
# Second fail-closed switch for the multi-model /create route. Budget is reserved in the DB
# (private.generation_models price catalog). Keep false until migration 20261118090000 is applied
# on hosted, the SQL acceptance tests pass and one live paid LTX job succeeds.
GENERATION_MULTIMODEL_ENABLED=false
HF_TOKEN=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional GA4 ID override (G-XXXXXXXXXX). Empty: the built-in site ID is used on Vercel production only.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
