NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy key, supported for existing projects only.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Keep disabled until staging Storage/concurrency acceptance is complete.
MEDIA_CLEANUP_ENABLED=false
# Separate cryptographically random 32-byte lowercase hex token; never NEXT_PUBLIC.
MEDIA_CLEANUP_SECRET=
# Separate worker credential for abandoned upload reconciliation.
MEDIA_UPLOAD_RECONCILE_ENABLED=false
MEDIA_UPLOAD_RECONCILE_SECRET=
# Shared scheduler bearer credential: separate random 32-byte lowercase hex.
CRON_SECRET=
# No paid provider calls until explicitly enabled and staging acceptance passes.
GENERATION_ENABLED=false
HF_TOKEN=
NEXT_PUBLIC_APP_URL=http://localhost:3000
